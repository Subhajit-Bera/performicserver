# ==============================================================================
# Performic Backend (Server) Environment Configuration Template
# ==============================================================================

# Server Environment & Port
PORT=3001
NODE_ENV=development

# Frontend Client URL (For CORS and OAuth redirects)
CLIENT_URL=http://localhost:3000

# Server Public URL (Used for Google OAuth callback registration)
SERVER_URL=http://localhost:3001

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/performic-db

# JWT Secrets for Authentication
# In production, replace with cryptographically secure random strings (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

